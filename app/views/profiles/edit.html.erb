<% content_for :title, "Ndrysho Fjalëkalimin" %>

<div class="w-full">
  <div class="max-w-xl mx-auto mt-8 p-6 bg-white rounded-lg shadow-md">
    <h1 class="text-3xl font-bold text-gray-800 mb-2 text-center">Ndrysho Fjalëkalimin</h1>
    <p class="text-gray-600 text-center mb-6">
      <%= "#{@user.name} #{@user.surname}" %> · <%= @user.email %>
    </p>

    <%= form_with model: @user, url: profile_path, method: :patch, local: true do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-600 p-4 rounded-lg mb-4">
          <% @user.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= form.label :current_password, 'Fjalëkalimi aktual', class: 'block text-gray-600 font-semibold' %>
          <%= form.password_field :current_password, required: true, autocomplete: 'current-password',
                                  class: 'mt-1 block w-full p-2 border border-gray-300 rounded' %>
        </div>

        <div>
          <%= form.label :password, 'Fjalëkalimi i ri', class: 'block text-gray-600 font-semibold' %>
          <%= form.password_field :password, required: true, minlength: 8, autocomplete: 'new-password',
                                  class: 'mt-1 block w-full p-2 border border-gray-300 rounded' %>
          <p class="text-xs text-gray-500 mt-1">Min. 8 karaktere.</p>
        </div>

        <div>
          <%= form.label :password_confirmation, 'Konfirmo fjalëkalimin e ri', class: 'block text-gray-600 font-semibold' %>
          <%= form.password_field :password_confirmation, required: true, minlength: 8, autocomplete: 'new-password',
                                  class: 'mt-1 block w-full p-2 border border-gray-300 rounded' %>
        </div>
      </div>

      <div class="flex justify-center space-x-4 mt-6">
        <%= form.submit 'Ruaj Fjalëkalimin', class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition cursor-pointer' %>
        <%= link_to 'Kthehu Prapa', root_path, class: 'bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition' %>
      </div>
    <% end %>
  </div>
</div>
