<% content_for :title, "Gjykatat" %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Gjykatat</h1>
      <p class="text-gray-600">Lista e gjykatave në formën e lëndës. Gjykatat nuk fshihen, vetëm çaktivizohen.</p>
    </div>
    <%= link_to new_admin_court_path, class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition' do %>
      <i class="fas fa-plus mr-2"></i>Gjykatë e Re
    <% end %>
  </div>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Renditja</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emri</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Lëndë</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statusi</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Veprime</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @courts.each do |court| %>
          <% used = @lawsuit_counts[court.name.downcase].to_i %>
          <tr class="<%= court.active? ? 'hover:bg-gray-50' : 'bg-gray-100 opacity-60' %>">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= court.position %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= court.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= used %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if court.active? %>
                <span class="inline-block bg-green-100 text-green-800 px-3 py-1 rounded-full text-xs font-semibold">Aktive</span>
              <% else %>
                <span class="inline-block bg-red-100 text-red-800 px-3 py-1 rounded-full text-xs font-semibold">Joaktive</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <div class="flex items-center space-x-2">
                <%= link_to 'Ndrysho', edit_admin_court_path(court),
                            class: 'px-4 py-2 border border-gray-500 text-gray-500 rounded hover:bg-gray-500 hover:text-white transition' %>
                <% if court.active? %>
                  <%= button_to 'Çaktivizo', toggle_active_admin_court_path(court), method: :patch,
                                data: { turbo_confirm: "Të çaktivizohet \"#{court.name}\"? Nuk do të ofrohet më në formën e lëndës. #{used} lëndë e mbajnë emrin." },
                                class: 'px-4 py-2 border border-red-500 text-red-600 rounded hover:bg-red-500 hover:text-white transition' %>
                <% else %>
                  <%= button_to 'Aktivizo', toggle_active_admin_court_path(court), method: :patch,
                                data: { turbo_confirm: "Të aktivizohet \"#{court.name}\"?" },
                                class: 'px-4 py-2 border border-green-600 text-green-700 rounded hover:bg-green-600 hover:text-white transition' %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
