<% content_for :title, "Admin" %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Admin</h1>
    <p class="text-gray-600">Menaxhimi i përdoruesve, i gjykatave dhe i lëndëve të fshira</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl">
    <!-- Users card -->
    <div class="bg-white shadow-md rounded-lg p-6">
      <div class="flex items-center mb-4">
        <i class="fas fa-users text-2xl text-gray-600 mr-3"></i>
        <h2 class="text-xl font-bold text-gray-800">Përdoruesit</h2>
      </div>
      <p class="text-4xl font-bold text-gray-800 mb-2"><%= @users_count %></p>
      <p class="text-sm mb-3">
        <span class="text-green-700 font-semibold">Aktiv: <%= @users_count - @inactive_users_count %></span>
        <span class="text-gray-400 mx-1">·</span>
        <span class="text-red-700 font-semibold">Joaktiv: <%= @inactive_users_count %></span>
      </p>
      <ul class="text-sm text-gray-600 space-y-1">
        <% User.roles.each_key do |role| %>
          <li><%= User.role_label(role) %>: <strong><%= @users_by_role[role].to_i %></strong></li>
        <% end %>
      </ul>
      <%= link_to "Menaxho Përdoruesit", admin_users_path,
                  class: "inline-block mt-4 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition" %>
    </div>

    <!-- Courts card -->
    <div class="bg-white shadow-md rounded-lg p-6">
      <div class="flex items-center mb-4">
        <i class="fas fa-landmark text-2xl text-gray-600 mr-3"></i>
        <h2 class="text-xl font-bold text-gray-800">Gjykatat</h2>
      </div>
      <p class="text-4xl font-bold text-gray-800 mb-2"><%= @courts_count %></p>
      <p class="text-sm mb-3">
        <span class="text-green-700 font-semibold">Aktive: <%= @courts_count - @inactive_courts_count %></span>
        <span class="text-gray-400 mx-1">·</span>
        <span class="text-red-700 font-semibold">Joaktive: <%= @inactive_courts_count %></span>
      </p>
      <%= link_to "Menaxho Gjykatat", admin_courts_path,
                  class: "inline-block mt-4 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition" %>
    </div>

    <!-- Deleted lawsuits card -->
    <div class="bg-white shadow-md rounded-lg p-6">
      <div class="flex items-center mb-4">
        <i class="fas fa-archive text-2xl text-gray-600 mr-3"></i>
        <h2 class="text-xl font-bold text-gray-800">Lëndët e Fshira</h2>
      </div>
      <p class="text-4xl font-bold text-gray-800 mb-4"><%= @deleted_lawsuits_count %></p>
      <%= link_to "Shiko Arkivin", deleted_lawsuits_path,
                  class: "inline-block bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition" %>
    </div>
  </div>
</div>
