<% content_for :title, "Përdoruesit" %>

<div class="container mx-auto px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Përdoruesit</h1>
      <p class="text-gray-600">Krijo dhe ndrysho përdoruesit e aplikacionit</p>
    </div>
    <%= link_to new_admin_user_path, class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition' do %>
      <i class="fas fa-user-plus mr-2"></i>Përdorues i Ri
    <% end %>
  </div>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Emri</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mbiemri</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID (KT)</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roli</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Veprime</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              <%= user.name %>
              <% if user.id == current_user.id %>
                <span class="ml-1 text-xs text-gray-500">(ju)</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.surname %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.email %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.kt_id %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= user.role&.titleize %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to 'Ndrysho', edit_admin_user_path(user),
                          class: 'px-4 py-2 border border-gray-500 text-gray-500 rounded hover:bg-gray-500 hover:text-white transition' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
