<div class="max-w-3xl mx-auto mt-8 p-6 bg-white rounded-lg shadow-md">
  <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center"><%= @lawsuit.title %></h1>

  <div class="space-y-4">
    <% if @lawsuit.category == "kontestet_punes"  %>
      <%= render 'lawsuits/categories/kontestet_punes_form' %>
    <% elsif @lawsuit.category == "kontestet_palet_treta_tk_padites" || @lawsuit.category == "kontestet_palet_treta_tk_paditur" %>
      <%= render 'lawsuits/categories/kontestet_palet_treta_form' %>
    <% elsif @lawsuit.category == "lendet_penale" %>
      <%= render 'lawsuits/categories/lendet_penale_form' %>
    <% elsif @lawsuit.category == "lendet_administrative" || @lawsuit.category == "lendet_administrative_inspektoriat" %>
      <%= render 'lawsuits/categories/lendet_administrative_form' %>
    <% elsif @lawsuit.category == "lendet_arbitrazhit" %>
      <%= render 'lawsuits/categories/lendet_arbitrazhit_form' %>
    <% else %>
      <%= render 'lawsuits/categories/lendet_permbarimore_form' %>
    <% end %>

    <div class="border rounded-lg p-4 bg-gray-50">
      <strong class="text-gray-600">Statusi Final i Lëndës:</strong>
      <p class="text-gray-800"><%= @lawsuit.final_status_label || 'N/A' %></p>
    </div>

    <div class="border rounded-lg p-4 bg-gray-50">
      <strong class="text-gray-600">Përfaqësuesi kryesor:</strong>
      <p class="text-gray-800"><%= @lawsuit.primary_representative ? "#{@lawsuit.primary_representative.name} #{@lawsuit.primary_representative.surname}" : 'N/A' %></p>
      <% if @lawsuit.secondary_representatives.any? %>
        <strong class="text-gray-600 block mt-2">Përfaqësues të tjerë:</strong>
        <p class="text-gray-800"><%= @lawsuit.secondary_representatives.map { |u| "#{u.name} #{u.surname}" }.join(', ') %></p>
      <% end %>

      <%# Admins only: who was representative and when (from PaperTrail, see Lawsuit#representative_history) %>
      <% if policy(@lawsuit).view_representative_history? %>
        <% history = @lawsuit.representative_history %>
        <% if history.any? %>
          <% user_name = ->(u) { u ? "#{u.name} #{u.surname}" : '-' } %>
          <% fmt = ->(t) { t.in_time_zone.strftime('%d.%m.%Y %H:%M') } %>
          <details class="mt-3">
            <summary class="cursor-pointer text-sm text-blue-600 hover:underline">Historiku i përfaqësuesve (<%= history.size %>)</summary>
            <div class="overflow-x-auto mt-2">
              <table class="min-w-full text-sm border">
                <thead class="bg-gray-100 text-gray-600">
                  <tr>
                    <th class="px-2 py-1 text-left">Përfaqësuesi</th>
                    <th class="px-2 py-1 text-left">Roli</th>
                    <th class="px-2 py-1 text-left">Nga</th>
                    <th class="px-2 py-1 text-left">Deri</th>
                    <th class="px-2 py-1 text-left">Caktuar nga</th>
                    <th class="px-2 py-1 text-left">Ndryshuar/Hequr nga</th>
                  </tr>
                </thead>
                <tbody>
                  <% history.each do |h| %>
                    <tr class="border-t">
                      <td class="px-2 py-1"><%= user_name.(h[:user]) %></td>
                      <td class="px-2 py-1"><%= h[:is_primary] ? 'Kryesor' : 'Tjetër' %></td>
                      <td class="px-2 py-1 whitespace-nowrap"><%= fmt.(h[:from]) %></td>
                      <td class="px-2 py-1 whitespace-nowrap"><%= h[:to] ? fmt.(h[:to]) : content_tag(:span, 'aktual', class: 'text-green-700 font-semibold') %></td>
                      <td class="px-2 py-1"><%= user_name.(h[:added_by]) %></td>
                      <td class="px-2 py-1"><%= h[:to] ? user_name.(h[:removed_by]) : '' %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </details>
        <% end %>
      <% end %>
    </div>

    <div class="border rounded-lg p-4 bg-gray-50">
      <strong class="text-gray-600">Natyra e Kontekstit:</strong>
      <p class="text-gray-800"><%= @lawsuit.context_type.present? ? @lawsuit.context_type : 'N/A' %></p>
    </div>

    <div class="border rounded-lg p-4 bg-gray-50">
      <strong class="text-gray-600">Pershkrimi:</strong>
      <p class="text-gray-800"><%= @lawsuit.description.present? ? @lawsuit.description : 'N/A' %></p>
    </div>
    <% if @lawsuit.pdf_files.attached? %>
      <div class="border rounded-lg p-4 bg-gray-50 mt-4">
        <strong class="text-gray-600">Dokumentet e Lendes:</strong>
        <ul class="mt-2 space-y-2">
          <% @lawsuit.pdf_files.order(created_at: :desc).each do |pdf| %>
            <li class="flex items-center">
              <!-- PDF icon and filename link -->
              <i class="fas fa-file-pdf text-red-500 mr-2"></i>
              <%= link_to pdf.filename.to_s, rails_blob_path(pdf, disposition: "inline"), target: "_blank", class: "text-blue-600 hover:underline mr-2" %>

              <!-- Download icon link -->
              <%= link_to rails_blob_path(pdf, disposition: "attachment"), download: pdf.filename.to_s, class: "text-gray-500 hover:text-gray-700" do %>
                <i class="fas fa-download ml-2"></i>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Deleted (hidden) PDFs: admin_developer only, with who/when/why + restore -->
    <%= render "deleted_pdfs", allow_restore: true %>

  </div>

  <div class="mt-6">
    <h3 class="text-2xl font-bold text-gray-800 border-b pb-2 mb-4">Provizionimet</h3>
    <div class="space-y-4">
      <% @lawsuit.provisions.order(provision_year: :desc).each do |provision| %>
        <div class="border border-gray-300 rounded-xl p-6 bg-gray-50 shadow hover:shadow-lg transition-shadow duration-300">
          <p class="text-lg text-gray-700 font-semibold">
            <span class="text-gray-900">Vlera e Provizionimit:</span>
            <span class="text-green-600"><%= number_to_currency(provision.provision_value, unit: "€") %></span>
          </p>
          <p class="text-md text-gray-600 mt-2">
            <span class="text-gray-900">Viti i Provizionimit:</span>
            <%= provision.provision_year %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- New Section: Comments -->
  <div class="mt-8">
    <% comments = @lawsuit.comments.includes(:user).order(created_at: :desc).to_a %>
    <h3 class="text-2xl font-bold text-gray-800 border-b pb-2 mb-4">Komentet (<%= comments.size %>)</h3>
    <div class="space-y-4">
      <%# Newest 3 always visible; older ones hidden until "Shfaq më shumë" %>
      <% comments.each_with_index do |comment, index| %>
        <div class="<%= 'hidden js-older-comment' if index >= 3 %> border border-gray-300 rounded-xl p-6 bg-gray-50 shadow hover:shadow-lg transition-shadow duration-300">
          <p class="text-gray-800 text-lg">
            <%= comment.content %>
          </p>
          <div class="mt-3 text-sm text-gray-500 flex justify-between items-center">
          <span class="font-medium">
            <i class="fas fa-user text-gray-400 mr-1"></i>
            <%= "#{comment.user.name} #{comment.user.surname} (ID: #{comment.user.kt_id})" %>
          </span>
            <span class="text-gray-400">
            <i class="fas fa-calendar-alt mr-1"></i>
              <%= comment.created_at.strftime('%d.%m.%Y') %>
          </span>
          </div>
        </div>
      <% end %>
    </div>

    <% if comments.size > 3 %>
      <div class="text-center mt-4">
        <button type="button"
                id="toggleOlderComments"
                data-more="Shfaq më shumë (<%= comments.size - 3 %>)"
                data-less="Shfaq më pak"
                onclick="toggleOlderComments(this)"
                class="px-4 py-2 border border-gray-500 text-gray-600 rounded hover:bg-gray-500 hover:text-white transition">
          Shfaq më shumë (<%= comments.size - 3 %>)
        </button>
      </div>
      <script>
        function toggleOlderComments(button) {
          const older = document.querySelectorAll('.js-older-comment');
          const showing = button.dataset.showing === 'true';
          older.forEach(el => el.classList.toggle('hidden', showing));
          button.dataset.showing = (!showing).toString();
          button.textContent = showing ? button.dataset.more : button.dataset.less;
        }
      </script>
    <% end %>
  </div>


  <div class="flex justify-center space-x-4 mt-6">
    <% if policy(@lawsuit).update? %>
      <%= link_to 'Ndrysho', edit_lawsuits_path(category: @lawsuit.category, id: @lawsuit.id), class: 'bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition' %>
    <% end %>
    <%= link_to 'Kthehu Prapa', filtered_lawsuits_path(category: @lawsuit.category), class: 'bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition' %>
    <% if current_user.admin? || current_user.admin_developer? %>
      <button type="button" 
              onclick="showDeleteModal()" 
              class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition">
        Delete
      </button>
    <% end %>

  </div>

</div>

<!-- Delete Confirmation Modal -->
<% if current_user.admin? || current_user.admin_developer? %>
  <div id="deleteModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" style="display: none;">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Confirm Deletion</h3>
        <div class="mt-2">
          <p class="text-sm text-gray-500 mb-4">
            Are you sure you want to delete this lawsuit? This action will archive the lawsuit and all associated data.
          </p>
          <%= form_with url: destroy_lawsuits_path(category: @lawsuit.category, id: @lawsuit.id), 
                        method: :delete,
                        local: true,
                        class: 'space-y-4' do |f| %>
            <div>
              <label for="deletion_reason" class="block text-sm font-medium text-gray-700 mb-2">
                Deletion Reason (Required):
              </label>
              <textarea name="deletion_reason" 
                        id="deletion_reason" 
                        rows="4" 
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
                        placeholder="Provide a reason for deleting this lawsuit..."></textarea>
            </div>
            <div class="flex space-x-2 justify-end">
              <button type="button" 
                      onclick="hideDeleteModal()"
                      class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600 transition">
                Cancel
              </button>
              <%= f.submit "Confirm Delete", 
                          class: "bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 transition" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
  function showDeleteModal() {
    const modal = document.getElementById('deleteModal');
    modal.classList.remove('hidden');
    modal.style.display = 'block';
  }
  
  function hideDeleteModal() {
    const modal = document.getElementById('deleteModal');
    modal.classList.add('hidden');
    modal.style.display = 'none';
    // Clear the textarea
    document.getElementById('deletion_reason').value = '';
  }
</script>


