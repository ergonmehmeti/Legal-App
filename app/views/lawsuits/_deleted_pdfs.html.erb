<%# Deleted (hidden) PDFs: admin_developer only, with who/when/why.
allow_restore: false on the archive page (restore the lawsuit first) %>
<% if policy(@lawsuit).view_deleted_pdfs? && @lawsuit.deleted_pdf_files.attached? %>
  <% deletions = @lawsuit.pdf_file_deletions.includes(:deleted_by_user).index_by(&:attachment_id) %>
  <% deleted_pdfs = @lawsuit.deleted_pdf_files_attachments.includes(:blob)
                            .sort_by { |pdf| deletions[pdf.id]&.created_at || pdf.created_at }.reverse %>
  <div class="border-2 border-red-200 rounded-lg p-4 bg-red-50 mt-4">
    <strong class="text-red-800"><i class="fas fa-eye-slash mr-1"></i> Dokumentet e Fshira (<%= deleted_pdfs.size %>)</strong>
    <p class="text-xs text-red-700 mb-3">Të dukshme vetëm për Admin Developer.</p>
    <ul class="space-y-3">
      <% deleted_pdfs.each do |pdf| %>
        <% deletion = deletions[pdf.id] %>
        <li class="bg-white p-3 rounded border border-red-100">
          <div class="flex items-center">
            <i class="fas fa-file-pdf text-gray-400 mr-2"></i>
            <%= link_to pdf.filename.to_s, rails_blob_path(pdf, disposition: "inline"), target: "_blank",
                        class: "text-blue-600 hover:underline mr-2 flex-1 break-all" %>
            <% if allow_restore %>
              <%= button_to "Rikthe", restore_lawsuit_pdf_file_path(lawsuit_id: @lawsuit.id, id: pdf.id),
                            method: :patch,
                            data: { turbo_confirm: "Të rikthehet dokumenti \"#{pdf.filename}\" në lëndë?" },
                            class: "px-3 py-1 text-sm border border-green-600 text-green-700 rounded hover:bg-green-600 hover:text-white transition" %>
            <% end %>
          </div>
          <% if deletion %>
            <p class="text-xs text-gray-600 mt-2">
              Fshirë nga <strong><%= "#{deletion.deleted_by_user.name} #{deletion.deleted_by_user.surname}" %></strong>
              (ID: <%= deletion.deleted_by_user.kt_id %>)
              më <%= deletion.created_at.strftime('%d.%m.%Y %H:%M') %>
            </p>
            <p class="text-sm text-gray-800 mt-1"><strong>Arsyeja:</strong> <%= deletion.reason %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
