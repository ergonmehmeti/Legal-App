<% if current_user.legal_representative? %>
  <%# Legal representative: two separate parts (HomeController#index):
      1. "Lëndët e mia": lawsuits they are assigned to (hidden if they only have category access)
      2. "Qasje në këto kategori": categories an admin gave them full read access to %>
  <div class="max-w-3xl">
    <% if @own_categories.any? || @scope_categories.empty? %>
      <h1 class="text-2xl font-bold text-gray-700 mb-1">Lëndët e mia</h1>
      <p class="text-sm text-gray-500 mb-4">Lëndët ku jeni caktuar si përfaqësues ligjor.</p>
      <% if @own_categories.empty? %>
        <div class="bg-white border border-gray-200 shadow-md rounded-lg p-6 text-gray-600 mb-8">
          Nuk keni lëndë të caktuara.
        </div>
      <% else %>
        <div class="bg-white border border-gray-200 shadow-md rounded-lg divide-y divide-gray-200 mb-4">
          <% @own_categories.each do |key, label| %>
            <%= link_to filtered_lawsuits_path(key),
                        class: "flex justify-between items-center px-6 py-4 hover:bg-gray-50 transition" do %>
              <span class="text-gray-700 font-semibold"><%= label %></span>
              <span class="bg-gray-600 text-white text-sm font-bold rounded-full px-3 py-1"><%= @own_counts[key].to_i %></span>
            <% end %>
          <% end %>
        </div>
        <div class="bg-white border border-gray-200 shadow-md rounded-lg p-6 mb-8">
          <%= bar_chart @own_categories.map { |key, label| [label, @own_counts[key].to_i] },
                        height: "#{[@own_categories.size * 50 + 60, 160].max}px",
                        legend: false,
                        library: { scales: { x: { ticks: { precision: 0 } } } } %><%# counts: whole numbers only (no 0.5) %>
        </div>
      <% end %>
    <% end %>

    <% if @scope_categories.any? %>
      <h2 class="text-2xl font-bold text-gray-700 mb-4">Qasje në këto kategori</h2>
      <div class="bg-white border border-blue-200 shadow-md rounded-lg divide-y divide-gray-200 mb-8">
        <% @scope_categories.each do |key, label| %>
          <%= link_to filtered_lawsuits_path(key),
                      class: "flex justify-between items-center px-6 py-4 hover:bg-blue-50 transition" do %>
            <span class="text-gray-700 font-semibold"><%= label %></span>
            <span class="bg-blue-600 text-white text-sm font-bold rounded-full px-3 py-1"><%= @scope_counts[key].to_i %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    <% @chart_data.each do |category_chart| %>
      <div class="bg-white border border-gray-200 shadow-md rounded-lg p-6">
        <!-- Chart Title -->
        <h2 class="text-xl font-bold text-gray-700 text-center mb-4">
          <%= link_to category_chart[:name], filtered_lawsuits_path(category_chart[:value]), class: "text-grey-900 hover:underline" %>
        </h2>

        <!-- Chart -->
        <div class="w-full max-w-3xl mx-auto">
          <%= column_chart category_chart[:data],
                           height: "300px",
                           library: {
                             title: { text: "Lawsuits by Status", fontSize: 16 },
                             legend: { position: "bottom" },
                             scales: { y: { ticks: { precision: 0 } } } # counts: whole numbers only (no 0.5)
                           }
          %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
